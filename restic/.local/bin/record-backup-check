#!/usr/bin/env bash
# Managed by ansible. Also mirrored in ~/dev/dotfiles/restic/.local/bin/
set -uo pipefail

HOST=""
RAN_AT=""
DURATION=""
EXIT_CODE=""
MODE=""
LOG=""

while [ $# -gt 0 ]; do
  case "$1" in
    --host)     HOST="$2";      shift 2 ;;
    --ran-at)   RAN_AT="$2";    shift 2 ;;
    --duration) DURATION="$2";  shift 2 ;;
    --exit)     EXIT_CODE="$2"; shift 2 ;;
    --mode)     MODE="$2";      shift 2 ;;
    --log)      LOG="$2";       shift 2 ;;
    *) echo "record-backup-check: unknown arg: $1" >&2; exit 2 ;;
  esac
done

: "${PSQL_CMD:=sudo -u postgres psql -d backup_metrics}"

if [ "$EXIT_CODE" = "0" ]; then SUCCESS="true"; else SUCCESS="false"; fi

ERROR_MSG=""
if [ "$SUCCESS" = "false" ] && [ -n "$LOG" ] && [ -f "$LOG" ]; then
  ERROR_MSG=$(tail -c 500 "$LOG" || true)
fi

CSV_ROW=$(jq -rn \
  --arg host "$HOST" \
  --arg ran_at "$RAN_AT" \
  --arg duration "$DURATION" \
  --arg success "$SUCCESS" \
  --arg exit_code "$EXIT_CODE" \
  --arg mode "$MODE" \
  --arg error "$ERROR_MSG" \
  '[
    $host, $ran_at, ($duration|tonumber), $success, ($exit_code|tonumber), $mode,
    (if $error == "" then null else $error end)
  ] | @csv')

{
  printf "COPY backup_checks (host, ran_at, duration_seconds, success, exit_code, mode, error_message) FROM STDIN WITH (FORMAT csv, NULL '');\n"
  printf '%s\n' "$CSV_ROW"
  printf '\\.\n'
} | $PSQL_CMD -q -v ON_ERROR_STOP=1
