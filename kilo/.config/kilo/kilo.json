{
  "$schema": "https://app.kilo.ai/config.json",
  "lsp": {},
  "enabled_providers": [
    "openrouter",
    "zai-coding-plan"
  ],
  "provider": {
    "openrouter": {
      "env": [
        "OPENROUTER_API_KEY"
      ],
      "whitelist": [
        "z-ai/glm-5.3-flash",
        "z-ai/glm-5.3",
      ]
    },
    "zai-coding-plan": {
      "env": [
        "ZHIPU_API_KEY"
      ],
      "models": {
        "glm-5.3-flash": {
          "name": "GLM-5.3-Flash"
        }
      },
      "whitelist": [
        "glm-5.3",
        "glm-5.3-flash"
      ]
    }
  },
  "permission": {
    "bash": "allow",
    "external_directory": {
      "~/*": "allow",
      "~/.config/**": "allow",
      "/tmp/**": "allow"
    },
    "edit": {
      "**/AGENTS.md": "allow",
      "~/*": "ask",
      "~/.config/**": "ask",
      "~/dev/dotfiles/**": "allow"
    },
    "openrouter_search-docs": {
      "*": "allow"
    }
  },
  "indexing": {
    "enabled": true,
    "provider": "openrouter",
    "model": "openai/text-embedding-3-large",
    "vectorStore": "lancedb"
  },
  "mcp": {
    "openrouter": {
      "type": "remote",
      "url": "https://mcp.openrouter.ai/mcp",
      "enabled": true
    }
  }
}
