{
  "$schema": "https://app.kilo.ai/config.json",
  "enabled_providers": [
    "openrouter"
  ],
  "provider": {
    "openrouter": {
      "env": [
        "OPENROUTER_API_KEY"
      ],
      "whitelist": [
        "moonshotai/kimi-k3",
        "deepseek/deepseek-v4-flash-0731",
        "deepseek/deepseek-v4-pro-0813",
        "qwen/qwen3-coder-next",
        "z-ai/glm-5.2",
        "z-ai/glm-5.1",
        "qwen/qwen3.6-27b",
        "qwen/qwen3.6-35b-a3b",
        "qwen/qwen3.8-2.4t-a95b",
        "tencent/hy3",
        "z-ai/glm-4.7-flash",
        "google/gemma-4-31b-it",
        "openai/gpt-5.6-luna",
        "openai/gpt-5.6-luna-pro"
      ]
    }
  },
  "permission": {
    "bash": "allow",
    "external_directory": {
      "/home/jonny/.config/*": "allow",
      "/home/jonny/.tmux/plugins/tpm/scripts/*": "allow",
      "/tmp/*": "allow",
      "/home/jonny/*": "allow"
    },
    "openrouter_search-docs": {
      "*": "allow"
    }
  },
  "indexing": {
    "enabled": true,
    "provider": "openrouter",
    "model": "text-embedding-3-small",
    "vectorStore": "lancedb"
  },
  "mcp": {
    "openrouter": {
      "type": "remote",
      "url": "https://mcp.openrouter.ai/mcp",
      "enabled": true
    }
  }
}